# Copy to integration/.env (gitignored) and adjust. These are throwaway
# demo values, but the plumbing is the production pattern: arkham resolves
# rule values from fnox at serve time, and the values reach the containers
# by environment — never from a committed rules file.
ARKHAM_REAL=ghp_deadbeefdeadbeefdeadbeefdeadbeefdeadbeef
ARKHAM_DB_REAL=postgres://arkham:arkham_real_password_01@db:5432/demo?sslmode=require
OIDC_CLIENT_SECRET=oidc-real-secret-0123456789
OIDC_ACCESS_TOKEN=real-access-token-abcdef123456
# Real Redis strings. `sslrootcert` is arkham's upstream trust anchor (parsed
# off the string before the dial); Redis itself never sees the query.
ARKHAM_REDIS_REAL=redis://arkham_user:arkham_real_redis_pass@redis:6379/0
ARKHAM_REDIS_TLS_REAL=rediss://arkham_user:arkham_real_redis_pass@redis:6380/0?sslrootcert=/certs/ca.crt
# Real SMTP strings. `starttls=required` withholds the password until the
# upstream leg is encrypted. `sslrootcert` is arkham's trust anchor.
ARKHAM_SMTP_REAL=smtp://agent%40demo.test:arkham_real_smtp_pass@mail:587?starttls=required&sslrootcert=/certs/ca.crt
ARKHAM_SMTPS_REAL=smtps://agent%40demo.test:arkham_real_smtp_pass@mail:465?sslrootcert=/certs/ca.crt
ARKHAM_SMTP_PASS=arkham_real_smtp_pass
