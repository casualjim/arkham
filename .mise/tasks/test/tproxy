#!/usr/bin/env bash

#MISE description="Run the live TPROXY tests (build as user, execute as root)"
#MISE sources=["Cargo.toml", "Cargo.lock", "src/**", "crates/**", "rules/**", ".mise/tasks/test/**"]
#USAGE flag "--use-sudo" help="Skip the gum escalation prompt and go straight to sudo"
#USAGE arg "[filters]" var=#true help="Test-name filters; default: tproxy_live_"

proj_dir=$(jj root 2>/dev/null || git rev-parse --show-toplevel)
cd "$proj_dir" || exit 1

set -euo pipefail

# Build the test binary as the current user so target/ stays user-owned.
cargo nextest run --locked --no-run --cargo-quiet --package arkham-tproxy

# Locate the test binary for this one package: the workspace has many, so the
# package filter is what makes the "exactly one" assertion meaningful.
test_bin=$(cargo nextest list --package arkham-tproxy --message-format json |
  jq -r '.["rust-suites"] |
  if length == 1 then first(.[]) | .["binary-path"] else error("expected 1 test binary, got \(length)") end')

# Default to the tproxy_live_ prefix unless the caller narrows it.
eval "filters=(${usage_filters:-})"
if [ ${#filters[@]} -eq 0 ]; then
  filters=(tproxy_live_)
fi

if [ "${usage_use_sudo:-false}" = "true" ]; then
  sudo "$test_bin" --test-threads=1 --ignored "${filters[@]}"
else
  if ! gum confirm "TPROXY tests need root; escalate with sudo?"; then
    echo "escalation declined; test binary: $test_bin" >&2
    exit 1
  fi
  sudo "$test_bin" --test-threads=1 --ignored "${filters[@]}"
fi
